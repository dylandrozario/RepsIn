# RepsIn pose server — OPTIONAL Supabase JWT verification.
#
# These enable the protected /me and authenticated /analyze behavior. The
# server still runs and tracks reps without them (anonymous demo mode).
#
# Copy to `.env` in this folder and fill in from your Supabase project.
# The JWT secret is a SERVER-ONLY secret — never ship it in the mobile app.

# Supabase Dashboard → Project Settings → API → JWT Secret (HS256).
SUPABASE_JWT_SECRET=

# Optional: your project ref (the subdomain of your project URL), used to
# validate the token issuer. e.g. abcdefghijklmno
SUPABASE_PROJECT_REF=
