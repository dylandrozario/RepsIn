# Supabase public configuration (safe to ship in the client — these are
# PUBLIC values, not secrets). Copy this file to `.env` and fill in the real
# values from your Supabase project: Dashboard → Project Settings → API.
#
# NEVER put the Supabase service_role key or any Google client secret here.
# Those are server-only secrets and must never ship in the mobile app.

# Your project URL, e.g. https://abcdefghijklmno.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The project's "anon" / publishable public API key (safe for clients).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
